{
    "metadata": {
        "name": "TransactionHistory",
        "http_method": "POST",
        "endpoint": "/api/TransactionHistory",
        "description": "Use this API to fetch monetary transaction posted on a card account. Combination of multiple filters such as date range, Transaction ID, Minimum Transaction Amount, Maximum Transaction Amount and Transaction type are present to fetch records of all transactions, settled transactions, outstanding transactions, expired transactions."
    },
    "request_fields": [
        {
            "name": "AccountNumber",
            "type": "string",
            "required": false,
            "description": "Account Number  of card Example:3002151478 Application Version is 1.3 Condition:At least Account Number / Card Number/ Proxy Number is required. Allowable Values: 19"
        },
        {
            "name": "ClientID",
            "type": "string",
            "required": false,
            "description": "Client ID Example: 1000 Allowable Values: 0"
        },
        {
            "name": "ClientPassword",
            "type": "string",
            "required": false,
            "description": "Client Password Example: ********* Allowable Values: 0"
        },
        {
            "name": "APIVersion",
            "type": "string",
            "required": true,
            "description": "Version of the API to be invoked Example: 1.3 Allowable Values: 10"
        },
        {
            "name": "IPAddress",
            "type": "string",
            "required": true,
            "description": "IP Address of sender Example:  10.206.0.204 Allowable Values: 15"
        },
        {
            "name": "Source",
            "type": "string",
            "required": true,
            "description": "Source from where API Call is initiated. CoreCard have multiple value of source for internal system (CoreMoney, SelfService, IVR, MobileSelfService) For external system expected source will be WEB. Allowable Values: 50"
        },
        {
            "name": "CallerID",
            "type": "string",
            "required": false,
            "description": "Caller Id of source from where API is initiated. It is End User phone number. Example: 7204454214 Condition - applicable in Case of IVR Allowable Values: 20"
        },
        {
            "name": "CalledID",
            "type": "string",
            "required": false,
            "description": "Called Id of destination for which API is initiated. It is Corecard IVR number. Example: 7314145404 Condition - applicable in Case of IVR Allowable Values: 20"
        },
        {
            "name": "SessionID",
            "type": "string",
            "required": false,
            "description": "Reserved for future use Allowable Values: 50"
        },
        {
            "name": "ANI",
            "type": "string",
            "required": false,
            "description": "Reserved for future use Allowable Values: 0"
        },
        {
            "name": "DNS",
            "type": "string",
            "required": false,
            "description": "Reserved for future use Allowable Values: 0"
        },
        {
            "name": "Language",
            "type": "string",
            "required": false,
            "description": "Flag to retrieve error message in specific language Example: 'en' for English Allowable Values: 2"
        },
        {
            "name": "RequestDate",
            "type": "string",
            "required": false,
            "description": "Request Date Time of API Format: MM-DD-YYYYTHH:MM:SS Example:- 11-12-2021T13:05:10 Allowable Values: 19"
        },
        {
            "name": "CardNumber",
            "type": "string",
            "required": null,
            "description": "Card Number of card Example:134567****1200 Application Version is 1.3 Condition:At least Card Number/ Proxy Number is required. Allowable Values: 16"
        },
        {
            "name": "ProxyNumber",
            "type": "string",
            "required": null,
            "description": "Proxy Number of card Example: 10501001744174117 Valid values :0-19 Condition : At least Card Number/ Proxy Number is required. Allowable Values: 19"
        },
        {
            "name": "NumberOfDays",
            "type": "string",
            "required": false,
            "description": "NumberOfDays Allowable Values: 3"
        },
        {
            "name": "NumberOfTransactions",
            "type": "string",
            "required": false,
            "description": "Number of Transactions Example: 5/10 Allowable Values: 4"
        },
        {
            "name": "FromDate",
            "type": "string",
            "required": false,
            "description": "Transactions can be searched by Transaction Date\" Example:20170528 Format :YYYYMMDD FromDate Allowable Values: 20"
        },
        {
            "name": "ToDate",
            "type": "string",
            "required": false,
            "description": "Transactions can be searched by Transaction Date Example:20170528 Format :YYYYMMDD Required when ToDate is passed in Input. Allowable Values: 20"
        },
        {
            "name": "TransferAmountFrom",
            "type": "string",
            "required": false,
            "description": "Transactions can be searched by Transaction amount greater or equal to Min Transaction Amount Example: 25.00 Allowable Values: 30"
        },
        {
            "name": "TransferAmountTo",
            "type": "string",
            "required": false,
            "description": "Transactions can be searched by Transaction amount less than or equal to Max Transaction Amount Example: 250.00 Allowable Values: 30"
        },
        {
            "name": "NumberOfSavingAcctTransactions",
            "type": "string",
            "required": false,
            "description": "NumberOfSavingAcctTransactions Allowable Values: 4"
        },
        {
            "name": "PageIndex",
            "type": "string",
            "required": false,
            "description": "Start Count of Transactions Example: 0,1,100 Allowable Values: 4"
        },
        {
            "name": "AllFlag",
            "type": "string",
            "required": false,
            "description": "All Flag Example: 0 = No 1 = Yes Allowable Values: 5"
        },
        {
            "name": "LocationID",
            "type": "string",
            "required": false,
            "description": "Location ID Example: 1 Allowable Values: 9"
        }
    ],
