{
    "metadata": {
        "name": "CustomerInfoUpdate",
        "http_method": "POST",
        "endpoint": "/api/WebHookNotification/UpdateNotification/CustomerInfoUpdate",
        "description": "This webhook is triggered when customer-specific information gets updated on the account. Below fields contain only a sample of fields updated."
    },
    "request_fields": [
        {
            "name": "AccountNumber",
            "type": "string",
            "required": null,
            "description": "Account Number associated with the event. The Account Number is consistently maintained at the Account level (one-to-one Mapping).\nValid Values: 0-9\nFormat: XXXXXXXXXXXXXXXX\nExample: 8000000000000037 Allowable Values: 19"
        },
        {
            "name": "AdminNumber",
            "type": "integer",
            "required": null,
            "description": "Admin Number associated with the event. Admin Number is always associated with a Card (Can be Primary or Secondary)\nValid Values:0-9\nFormat:XXXXX\nExample:12345"
        },
        {
            "name": "RequestID",
            "type": "string",
            "required": null,
            "description": "Primary Key for API\nFormat:XXXXXXXXXXXXXXXX\nExample:12345 Allowable Values: 19"
        },
        {
            "name": "Mode",
            "type": "string",
            "required": null,
            "description": "Indicates the type of activity performed which triggered this webhook Possible Value: Alert, Insert, Transaction Allowable Values: 10"
        },
        {
            "name": "AccountUniversalUniqueID",
            "type": "string",
            "required": null,
            "description": "Universal Unique ID for Account\nFormat:XXXXXXXXXX\nExample:9894f28b-d051-4eaa-9e48-a3a7d5b4a6f7 Allowable Values: 64"
        },
        {
            "name": "ClientID",
            "type": "string",
            "required": null,
            "description": "Corecard's Client ID Allowable Values: 64"
        },
        {
            "name": "CardUniversalUniqueID",
            "type": "string",
            "required": null,
            "description": "Universal Unique ID for Admin\nFormat:XXXXXXXXXX\nExample: 8638-b87b-48d0-8e13-0ebb5643577 Allowable Values: 64"
        },
        {
            "name": "RequestUniversalUniqueID",
            "type": "string",
            "required": null,
            "description": "UniversalUniqueID Request\nExample: 8638-b87b-48d0-8e13-0ebb5643577 Allowable Values: 64"
        },
        {
            "name": "User",
            "type": "string",
            "required": null,
            "description": "User ID of the user who triggered the webhook event. \nValid Values: CoreCredit user, API user, System Allowable Values: 40"
        },
        {
            "name": "DateandTime",
            "type": "DateTime",
            "required": null,
            "description": "Timestamp when notification was sent\nYYYY-MM-DD hh:mm:ss:sss \n(24-hour Format)"
        },
        {
            "name": "AlertType",
            "type": "string",
            "required": null,
            "description": "Indicates type of Alert\nValid Values:RealTime or Re Try (due to time-out) Allowable Values: 15"
        },
        {
            "name": "Source",
            "type": "string",
            "required": null,
            "description": "Indicates the source from where the activity was performed by user or triggered by system. \nValid Values: CoreCredit, External API, Self Service, CoreCollect, IVR, System, CoreIssue Allowable Values: 20"
        },
        {
            "name": "ServiceName",
            "type": "string",
            "required": null,
            "description": "Name of API service (webhook) triggered Allowable Values: 40"
        },
        {
            "name": "TransactionSource",
            "type": "string",
            "required": null,
            "description": "Transaction Source of transaction\nValid Values:IPM, Retail Manual Auth-Installment, Retail Manual Auth-Revolver etc. Allowable Values: 40"
        },
        {
            "name": "InstitutionID",
            "type": "integer",
            "required": null,
            "description": "A unique identifier assigned by Corecard for Institution"
        },
        {
            "name": "ProductID",
            "type": "integer",
            "required": null,
            "description": "A unique identifier assigned by Corecard for Product"
        },
        {
            "name": "AlertRecipientType",
            "type": "integer",
            "required": null,
            "description": "Type of recipient to which alert needs to be sent\nValid Values:1=Primary Applicant,2=Cosigner,3=Applicant and Cosigner,4=Auth User,5=Applicant and Auth Use"
        },
        {
            "name": "UpdateCallList",
            "type": "",
            "required": null,
            "description": "Group element will always null for collection"
        },
        {
            "name": "Category",
            "type": "",
            "required": null,
            "description": "Group of fields passed in webhook"
        },
        {
            "name": "CategoryName",
            "type": "string",
            "required": null,
            "description": "Indicates category of alert triggered\nPossible values:\nAccount Creation, Payment Schedule, Manage Bank Account, Create Secondary card, Card Replacement, Customer Information, Update Credit Limit, Update Manual Status, Loyalty Redemption, Loyalty Manual Redemption, Loyalty Points Adjustments, Card Activation, CollateralID, Update System Status, Update Card Status, Card Auto Reissue, Dispute Release OTB, PromotionalReward Allowable Values: 40"
        },
        {
            "name": "CategoryID",
            "type": "integer",
            "required": null,
            "description": "Numeric unique identifier for Category"
        },
        {
            "name": "CategoryFieldList",
            "type": "array",
            "required": null,
            "description": "Array of fields passed in webhook"
        },
        {
            "name": "ModifiedFieldName",
            "type": "string",
            "required": null,
            "description": "Indicates cashback policy is updated on the card Allowable Values: 40"
        },
        {
            "name": "OldValue",
            "type": "string",
            "required": null,
            "description": "Represents the previous value of the field being updated. For insert operations, this will be null. This tag is applicable only for updates Allowable Values: 40"
        },
        {
            "name": "NewValue",
            "type": "string",
            "required": null,
            "description": "Indicates the new value assigned to the field being updated/modified. Allowable Values: 40"
        },
        {
            "name": "CardnumLast4Digits",
            "type": "string",
            "required": null,
            "description": "Last 4 digits of card number Allowable Values: 4"
        },
